//
// Nextflow Configuration for End-to-End Genome Annotation Workflow
// Adheres to strict DSL2 and resource isolation standards:
// 1. Clean container runtime environment (--cleanenv)
// 2. No base memory directive in process { ... }
// 3. Explicit memory and cpu directives per withName / label block
// 4. No time directives (queue is the sole wall-time decision)
//

plugins {
    id 'nf-schema@2.7.2'
}

nextflow.enable.moduleBinaries = true

params {
    // Top-level input/output
    assembly             = null
    fai                  = null
    outdir               = null
    publish_dir_mode     = 'copy'
    help                 = false
    representative_gtf   = null
    representative_faa   = null
    interproscan_dir     = null
    skip_functional_annotation = false
    skip_te_scoring      = false
    orthogroups_tsv      = null
    satellites_bed       = null
    ncrna_gff            = null
    braker_gtf           = null
    braker_aa            = null
    braker_hints         = null
    helixer_gff3         = null
    helixer_gtf          = null
    interproscan_tsv     = null
    interproscan_gff3    = null

    // Satellite parameters
    window_size          = 500000
    min_period           = 50
    min_copies           = 100
    min_identity         = 85

    // TE discovery parameters
    clade                = 'rhabditida'
    dfam_dir             = null
    dfam_h5              = null
    earlgrey_dir         = null
    earlgrey_seed_dir    = null
    structural_mask_bed  = null

    // ncRNA parameters
    rfam_cm              = null

    // Spliced Leader Discovery & Realignment
    rnaseq_samplesheet   = null
    bam                  = null
    bams                 = null
    min_support          = 5
    max_dist             = 1000
    min_tail_len         = 8
    strandedness         = 0
    slidr_scale          = 1.0
    acceptor             = 'AG'
    max_leader_gene_distance = 1000

    // Gene Prediction
    proteins             = null
    run_helixer          = false
    helixer_lineage      = 'invertebrate'
    helixer_model_path   = null
    busco_lineage        = 'chromadorea_odb12'
    busco_lineages_path  = null

    // Skip flags (all false for end-to-end)
    skip_repeats         = false
    skip_te              = false
    skip_ncrna           = false
    skip_rnaseq          = false
    skip_sl_discovery    = false
    skip_gene_prediction = false
    skip_helixer         = true
}

executor {
    name           = "lsf"
    perJobMemLimit = true
    perTaskReserve = false
}

process {
    executor       = "lsf"
    queue          = "normal"
    resourceLimits = [ cpus: 32, memory: 64.GB ]

    // Resilient failure handling:
    // If a task experiences transient resource exhaustion:
    // - OOM / memory limit: 130 (LSF TERM_MEMLIMIT), 137, 143, 104
    // - Bus error / segfault: 134, 139
    // - Walltime limit: 140 (LSF TERM_RUNLIMIT)
    // Retry up to 2 times, dynamically scaling memory or rerouting queues.
    // For other non-transient failures, finish all currently running/active jobs rather than terminating abruptly.
    errorStrategy = { task.exitStatus in [130, 140, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // 1. Repeats & Satellites
    withName: '.*:BEDTOOLS_MAKEWINDOWS' {
        cpus       = 1
        memory     = 4.GB
        ext.args   = "-w ${params.window_size}"
    }

    withName: '.*:BEDTOOLS_GETFASTA' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-nameOnly"
    }

    withName: '.*:TRF' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-d -h"
    }

    withName: '.*:SATELLITEFILTER' {
        cpus       = 1
        memory     = 4.GB
    }

    withName: '.*:VSEARCH_CLUSTER' {
        cpus       = 4
        memory     = 16.GB
        ext.args   = "--id 0.90"
        ext.args2  = "--cluster_fast"
        ext.args3  = "--centroids"
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BLAST_MAKEBLASTDB' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-dbtype nucl"
    }

    withName: '.*:BLAST_BLASTN' {
        cpus       = 8
        memory     = 16.GB
        ext.args   = '-evalue 0.01 -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore"'
    }

    withName: '.*:BLASTTOBED' {
        cpus       = 1
        memory     = 4.GB
    }

    withName: '.*:SATELLITEPROFILER' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BEDTOOLS_MERGE_SATELLITES' {
        cpus       = 1
        memory     = 4.GB
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BEDTOOLS_MASK_SATELLITES' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-soft"
        ext.prefix = { "${meta.id}_satellites_softmasked" }
    }

    withName: '.*:BEDTOOLS_HARDMASK_SATELLITES' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = ""
        ext.prefix = { "${meta.id}_satellites_hardmasked" }
    }

    withName: '.*EARLGREY' {
        queue            = { task.exitStatus == 140 ? 'basement' : (task.attempt > 1 ? 'long' : 'long') }
        cpus             = 8
        memory           = { (32.GB * (1.5 ** (task.attempt - 1))) }
        ext.args         = "-e yes"
        containerOptions = {
            (workflow.containerEngine == 'singularity' && params.dfam_h5 && params.dfam_dir) ?
            "--env PERL5LIB=/usr/local/share/RepeatMasker --bind ${params.dfam_h5}:/usr/local/share/RepeatMasker/Libraries/Dfam.h5 --bind ${params.dfam_dir}:/usr/local/share/RepeatMasker/Libraries/famdb" : ''
        }
        publishDir = [
            path: { "${params.outdir}/earlgrey" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BEDTOOLS_MASK_TE' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-soft"
        ext.prefix = { "${meta.id}_repeats_softmasked" }
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: params.publish_dir_mode
        ]
    }

    // 2. ncRNA Annotation
    withName: '.*INFERNAL_CMSCAN$' {
        cpus       = 8
        memory     = { (16.GB * (1.5 ** (task.attempt - 1))) }
        ext.args   = "--rfam --cut_ga --nohmmonly"
        publishDir = [
            path: { "${params.outdir}/ncrna" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*INFERNAL_CMSCANTOGFF3.*' {
        cpus       = 1
        memory     = 4.GB
        publishDir = [
            path: { "${params.outdir}/ncrna" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BEDTOOLS_MERGE_NCRNA|.*:BEDTOOLS_MERGE_NCRNA' {
        cpus       = 1
        memory     = 4.GB
        publishDir = [
            path: { "${params.outdir}/ncrna" },
            mode: params.publish_dir_mode
        ]
    }

    // 3. RNA-seq Realignment & SLID
    withName: '.*:HISAT2_BUILD' {
        cpus       = 8
        memory     = 32.GB
    }

    withName: '.*:SAMTOOLS_COLLATEFASTQ' {
        cpus       = 4
        memory     = 16.GB
    }

    withName: '.*:SLIDR_ALIGNREADS' {
        cpus       = 16
        memory     = 32.GB
        ext.args   = {
            def min_score = "-0.4"
            if (params.slidr_scale != 1.0) {
                min_score = String.format(java.util.Locale.US, "%.4f", -0.4 * (params.slidr_scale as double))
            }
            "--sp 1,0 --mp 3,1 --score-min L,5,${min_score} --dta"
        }
        publishDir = [
            path: { "${params.outdir}/rnaseq_alignments" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }

    withName: '.*:SAMTOOLS_MERGE' {
        cpus       = 8
        memory     = 32.GB
        publishDir = [
            path: { "${params.outdir}/rnaseq_merged" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BARRNAP' {
        cpus       = 4
        memory     = 8.GB
    }

    withName: '.*:SLIDR_EXTRACTTAILS' {
        cpus       = 4
        memory     = 16.GB
        ext.args   = "--min-tail-len ${params.min_tail_len} --strandedness ${params.strandedness}"
        publishDir = [
            path: { "${params.outdir}/slidr/tails" },
            mode: params.publish_dir_mode,
            pattern: "*.{fa.gz,json}"
        ]
    }

    withName: '.*:SLIDR_CLUSTERTAILS' {
        cpus       = 8
        memory     = 32.GB
        publishDir = [
            path: { "${params.outdir}/slidr/clusters" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:SLIDR_SLRNASITES' {
        cpus       = 8
        memory     = 16.GB
    }

    withName: '.*:SLIDR_SLRNAFILTER' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/slidr/leader_rnas" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:SLIDR_CONSENSUS' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/slidr/consensus" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:SLIDR_TSSEXPORTER' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/slidr/tss" },
            mode: params.publish_dir_mode
        ]
    }

    // 4. Gene Prediction & Consensus
    withName: '.*BRAKER3.*' {
        container  = 'docker.io/teambraker/braker3:v3.0.7.6'
        queue      = 'normal'
        cpus       = 8
        memory     = { (16.GB * (1.5 ** (task.attempt - 1))) }
        publishDir = [
            path: { "${params.outdir}/braker3" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '(.*:)?HELIXER' {
        queue      = 'normal'
        cpus       = 8
        memory     = { (24.GB * (2 ** (task.attempt - 1))) }
        ext.args   = { params.helixer_model_path ? "--downloaded-model-path ${params.helixer_model_path}" : '' }
        container  = 'docker.io/gglyptodon/helixer-docker:helixer_v0.3.6_cuda_12.2.2-cudnn8_1'
        publishDir = [
            path: { "${params.outdir}/helixer" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*GFFREAD.*' {
        cpus       = 2
        memory     = 8.GB
        container  = 'quay.io/biocontainers/gffread:0.12.7--hdcf5f25_4'
    }

    withName: '(.*:)?TSEBRA' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/tsebra" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*BUSCO.*' {
        cpus                = 4
        memory              = { (8.GB * (1.5 ** (task.attempt - 1))) }
        ext.prune_sequences = true
        publishDir = [
            path: { "${params.outdir}/busco" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*ANNOTATIONSUMMARY.*' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*INTERPROSCAN.*' {
        cpus       = 16
        memory     = { (16.GB * (1.5 ** (task.attempt - 1))) }
        publishDir = [
            path: { "${params.outdir}/functional_annotation/interproscan" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*SLOPPR_OPERONS.*' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/operons" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*SELECTBESTMODEL.*' {
        cpus       = 4
        memory     = 12.GB
        publishDir = [
            path: { "${params.outdir}/representative_annotation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*TESCORER.*' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/te_scoring" },
            mode: params.publish_dir_mode
        ]
    }
}

env {
    PYTHONNOUSERSITE = '1'
}

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '60m'
    runOptions  = '--cleanenv'
}

// Production publishing & featureCounts / CRAM configuration
process {
    withName: 'BAM_TO_CRAM|.*:BAM_TO_CRAM' {
        cpus       = 4
        memory     = 16.GB
        ext.args   = "--output-fmt cram"
        publishDir = [
            path: { "${params.outdir}/rnaseq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'INDEX_CRAM|.*:INDEX_CRAM' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/rnaseq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:?SUBREAD_FEATURECOUNTS' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-p -t exon,CDS -g gene_id"
        publishDir = [
            path: { "${params.outdir}/expression" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:ARCHIVE_SUBOPTIMAL_MODELS' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/representative_annotation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:GFFREAD_REPRESENTATIVE_FAA' {
        cpus       = 2
        memory     = 8.GB
        ext.prefix = { "${meta.id}.protein" }
        publishDir = [
            path: { "${params.outdir}/representative_annotation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:GFFREAD_REPRESENTATIVE_FNA' {
        cpus       = 2
        memory     = 8.GB
        ext.prefix = { "${meta.id}.cds" }
        publishDir = [
            path: { "${params.outdir}/representative_annotation" },
            mode: params.publish_dir_mode
        ]
    }
}

manifest {
    name            = 'nf-core/nematodeannotation'
    author          = 'Pablo M. Gonzalez de la Rosa'
    homePage        = 'https://github.com/pgonzale60/nf-core-nematodeannotation'
    description     = 'Automated dual-evidence and tournament genome annotation pipeline for nematodes'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0dev'
    defaultBranch   = 'main'
}


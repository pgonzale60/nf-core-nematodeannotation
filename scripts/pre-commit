#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Check if any Nextflow, Python, or schema files are staged
STAGED_NF="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.nf$' || true)"
STAGED_PY="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)"
STAGED_SCHEMAS="$(git diff --cached --name-only --diff-filter=ACMR | grep -E 'assets/schemas/.*\.json$' || true)"

if [[ -n "${STAGED_PY}" || -n "${STAGED_SCHEMAS}" || -n "${STAGED_NF}" ]]; then
    echo "[pre-commit] 1/4 Checking Python syntax & escape sequences (-W error)..."
    if [[ -n "${STAGED_PY}" ]]; then
        # shellcheck disable=SC2086
        python3 -W error -m py_compile ${STAGED_PY}
    fi

    echo "[pre-commit] 2/4 Running contract test suite..."
    python3 "${REPO_ROOT}/scripts/check_data_contracts.py"
fi

echo "[pre-commit] 3/4 Auto-stamping Nextflow module Script-SHAs..."
python3 "${REPO_ROOT}/scripts/stamp_module_shas.py" --pre-commit
python3 "${REPO_ROOT}/scripts/stamp_module_shas.py" --check

echo "[pre-commit] 4/4 Extracting & verifying AST/code contracts (docs/CODE_CONTRACTS.md)..."
python3 "${REPO_ROOT}/scripts/extract_code_contracts.py" --pre-commit
python3 "${REPO_ROOT}/scripts/extract_code_contracts.py" --check

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/nematodeannotation/master/nextflow_schema.json",
    "title": "nf-core/nematodeannotation pipeline parameters",
    "description": "Automated dual-evidence and tournament genome annotation pipeline for nematodes",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Core inputs and outputs for the annotation pipeline.",
            "required": [
                "assembly",
                "outdir"
            ],
            "properties": {
                "assembly": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.(fa|fasta|fna|fa\\.gz|fasta\\.gz|fna\\.gz|fa\\.bgz)$",
                    "description": "Path to input genome assembly FASTA (.fa, .fasta, .fna, optionally gzip compressed).",
                    "help_text": "Mandatory genome assembly file. Compressed assemblies (.gz, .bgz) are uncompressed on-the-fly.",
                    "fa_icon": "fas fa-dna"
                },
                "fai": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.fai$",
                    "description": "Path to assembly FASTA index (.fai). If omitted, generated automatically with samtools faidx.",
                    "fa_icon": "far fa-file-code"
                },
                "rnaseq_samplesheet": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to CSV samplesheet specifying RNA-seq datasets (CRAMs, FASTQs, or pre-aligned BAMs).",
                    "help_text": "CSV samplesheet with columns: sample, cram, crai, fastq_1, fastq_2, bam, bai.",
                    "fa_icon": "fas fa-file-csv"
                },
                "bam": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.bam$",
                    "description": "Pre-computed coordinate-sorted RNA-seq BAM file.",
                    "fa_icon": "fas fa-file"
                },
                "bams": {
                    "type": "string",
                    "description": "Comma-separated list or glob of BAM files.",
                    "fa_icon": "fas fa-file"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to output directory where results will be published.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "repeats_and_satellites": {
            "title": "Repeats and Satellites options",
            "type": "object",
            "fa_icon": "fas fa-repeat",
            "description": "Parameters governing tandem satellite repeat discovery and Earl Grey transposable element annotation.",
            "properties": {
                "window_size": {
                    "type": "integer",
                    "default": 500000,
                    "description": "Window size for splitting chromosomes during satellite scanning (bp)."
                },
                "min_period": {
                    "type": "integer",
                    "default": 50,
                    "description": "Minimum repeat period size (bp) for satellite discovery."
                },
                "min_copies": {
                    "type": "integer",
                    "default": 100,
                    "description": "Minimum tandem copy count required to qualify as satellite array."
                },
                "min_identity": {
                    "type": "integer",
                    "default": 85,
                    "description": "Minimum sequence identity percentage for tandem repeat unit consistency."
                },
                "clade": {
                    "type": "string",
                    "default": "rhabditida",
                    "description": "Taxonomic clade for RepeatModeler/RepeatMasker/Dfam searches."
                },
                "dfam_dir": {
                    "type": "string",
                    "default": "/data/tol/resources/dfam/3.9/families/FamDB",
                    "description": "Path to Dfam FamDB directory."
                },
                "dfam_h5": {
                    "type": "string",
                    "default": "/lustre/scratch122/tol/teams/blaxter/users/pg17/pde_workbench/data/rm_bypass/Dfam.h5",
                    "description": "Path to Dfam.h5 file."
                },
                "earlgrey_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Pre-computed Earl Grey repeat run directory for bypassing TE discovery."
                },
                "earlgrey_seed_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Alternative alias for pre-computed Earl Grey repeat run directory."
                }
            }
        },
        "ncrna_annotation": {
            "title": "ncRNA Annotation options",
            "type": "object",
            "fa_icon": "fas fa-project-diagram",
            "description": "Parameters for structural RNA annotation via Infernal cmscan.",
            "properties": {
                "rfam_cm": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Path to Rfam covariance models (Rfam.cm) with binary indices (.i1f, .i1i, .i1m, .i1p).",
                    "fa_icon": "fas fa-database"
                },
                "ncrna_gff": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed ncRNA GFF3 file (bypasses Infernal cmscan).",
                    "fa_icon": "fas fa-file-code"
                }
            }
        },
        "spliced_leader_discovery": {
            "title": "Spliced Leader and Operon options",
            "type": "object",
            "fa_icon": "fas fa-scissors",
            "description": "Parameters for SLIDR trans-splicing spliced leader discovery and operon demarcation.",
            "properties": {
                "min_support": {
                    "type": "integer",
                    "default": 5,
                    "description": "Minimum soft-clipped read support for SL acceptor site identification."
                },
                "max_dist": {
                    "type": "integer",
                    "default": 1000,
                    "description": "Maximum distance between SL site and annotated start codon."
                },
                "min_tail_len": {
                    "type": "integer",
                    "default": 8,
                    "description": "Minimum clipped leader tail length in reads."
                },
                "strandedness": {
                    "type": "integer",
                    "default": 0,
                    "description": "Strandedness of RNA-seq data (0: unstranded, 1: forward, 2: reverse)."
                },
                "slidr_scale": {
                    "type": "number",
                    "default": 1.0,
                    "description": "Scaling factor for SLIDR tail extraction scoring."
                },
                "acceptor": {
                    "type": "string",
                    "default": "AG",
                    "description": "Splice acceptor dinucleotide motif."
                },
                "max_leader_gene_distance": {
                    "type": "integer",
                    "default": 1000,
                    "description": "Maximum distance between SL site and gene model for operon assignment."
                }
            }
        },
        "gene_prediction_options": {
            "title": "Gene Prediction options",
            "type": "object",
            "fa_icon": "fas fa-microscope",
            "description": "Parameters for BRAKER3, Helixer, TSEBRA model reconciliation, and BUSCO QC.",
            "properties": {
                "proteins": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Path to reference/OrthoDB protein FASTA for BRAKER3 homology hints.",
                    "fa_icon": "fas fa-file"
                },
                "helixer_lineage": {
                    "type": "string",
                    "default": "invertebrate",
                    "description": "Helixer neural network lineage model ('invertebrate', 'fungi', 'vertebrate', 'land_plant')."
                },
                "busco_lineage": {
                    "type": "string",
                    "default": "chromadorea_odb12",
                    "description": "BUSCO lineage dataset for protein completeness assessment."
                },
                "busco_lineages_path": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Local path to offline BUSCO lineages dataset directory.",
                    "fa_icon": "fas fa-folder"
                }
            }
        },
        "functional_annotation_and_scoring": {
            "title": "Functional Annotation and TE Scoring options",
            "type": "object",
            "fa_icon": "fas fa-tags",
            "description": "Parameters for InterProScan domain annotation, orthology, and TE-derived gene model penalization.",
            "properties": {
                "interproscan_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Path to local InterProScan data directory containing data/ and bin/."
                },
                "orthogroups_tsv": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Path to OrthoFinder Orthogroups.tsv matrix."
                },
                "satellites_bed": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed satellite annotations BED."
                }
            }
        },
        "bypass_and_precomputed_options": {
            "title": "Bypass and Pre-computed Model options",
            "type": "object",
            "fa_icon": "fas fa-forward",
            "description": "Options to supply pre-computed outputs to bypass heavy compute stages.",
            "properties": {
                "representative_gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed winning gene models GTF (bypasses BRAKER/Helixer/TSEBRA tournament)."
                },
                "representative_faa": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed winning proteins FASTA."
                },
                "braker_gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed BRAKER GTF."
                },
                "braker_aa": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed BRAKER protein FASTA."
                },
                "braker_hints": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed BRAKER hints file."
                },
                "helixer_gff3": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed Helixer GFF3."
                },
                "helixer_gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed Helixer GTF."
                },
                "interproscan_tsv": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed InterProScan TSV output."
                },
                "interproscan_gff3": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Pre-computed InterProScan GFF3 output."
                }
            }
        },
        "pipeline_skips": {
            "title": "Pipeline Stage Skips",
            "type": "object",
            "fa_icon": "fas fa-step-forward",
            "description": "Flags to skip specific pipeline execution stages.",
            "properties": {
                "skip_repeats": {
                    "type": "boolean",
                    "description": "Skip repeat and satellite annotation (Centroids + Earl Grey)."
                },
                "skip_te": {
                    "type": "boolean",
                    "description": "Skip Earl Grey TE discovery."
                },
                "skip_ncrna": {
                    "type": "boolean",
                    "description": "Skip ncRNA structural annotation via Infernal cmscan."
                },
                "skip_rnaseq": {
                    "type": "boolean",
                    "description": "Skip RNA-seq alignment and CRAM conversion."
                },
                "skip_sl_discovery": {
                    "type": "boolean",
                    "description": "Skip spliced leader discovery."
                },
                "skip_gene_prediction": {
                    "type": "boolean",
                    "description": "Skip BRAKER3 and Helixer gene prediction."
                },
                "skip_functional_annotation": {
                    "type": "boolean",
                    "description": "Skip InterProScan functional domain annotation."
                },
                "skip_te_scoring": {
                    "type": "boolean",
                    "description": "Skip TE-derived model penalization scoring."
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-alt",
            "description": "Standard pipeline execution controls.",
            "properties": {
                "help": {
                    "type": "boolean",
                    "description": "Display help message and exit."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/repeats_and_satellites"
        },
        {
            "$ref": "#/$defs/ncrna_annotation"
        },
        {
            "$ref": "#/$defs/spliced_leader_discovery"
        },
        {
            "$ref": "#/$defs/gene_prediction_options"
        },
        {
            "$ref": "#/$defs/functional_annotation_and_scoring"
        },
        {
            "$ref": "#/$defs/bypass_and_precomputed_options"
        },
        {
            "$ref": "#/$defs/pipeline_skips"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
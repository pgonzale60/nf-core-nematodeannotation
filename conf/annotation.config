/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sanger Farm22 Cluster & Pipeline Resource Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    max_memory = 128.GB
    max_cpus   = 32
    max_time   = 48.h

    // Defaults
    window_size         = 100000
    species_name        = "Nematoda"
    helixer_lineage     = "invertebrate"
    busco_lineage       = "chromadorea_odb12"
    hisat2_build_memory = "200.GB"
    dfam_h5             = "/lustre/scratch122/tol/teams/blaxter/users/pg17/pde_workbench/data/rm_bypass/Dfam.h5"
    dfam_dir            = "/lustre/scratch122/tol/teams/blaxter/users/pg17/pde_workbench/data/rm_bypass"
}

process {
    executor      = "lsf"
    queue         = "normal"

    // Resilient failure handling:
    // - OOM / memory limit: 130 (LSF TERM_MEMLIMIT), 137, 143, 104
    // - Bus error / segfault: 134, 139
    // - Walltime limit: 140 (LSF TERM_RUNLIMIT) -> routes to basement
    errorStrategy = { task.exitStatus in [130, 140, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // 1. Repeats & Satellites
    withName: '.*:BEDTOOLS_MAKEWINDOWS' {
        cpus       = 1
        memory     = 4.GB
        ext.args   = "-w ${params.window_size}"
    }

    withName: '.*:BEDTOOLS_GETFASTA' {
        cpus       = 1
        memory     = 4.GB
    }

    withName: '.*:TRF' {
        cpus       = 4
        memory     = 8.GB
        ext.args   = "2 7 7 80 10 50 500 -d -h"
    }

    withName: '.*:SATELLITEFILTER' {
        cpus       = 1
        memory     = 4.GB
        ext.args   = "--min-copy-number 5 --min-period 10 --max-period 2000 --min-total-length 100"
    }

    withName: '.*:VSEARCH_CLUSTER' {
        cpus       = 4
        memory     = 16.GB
        ext.args   = "--id 0.80 --strand both"
    }

    withName: '.*:BLAST_MAKEBLASTDB' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-dbtype nucl"
    }

    withName: '.*:BLAST_BLASTN' {
        cpus       = 8
        memory     = 16.GB
        ext.args   = "-perc_identity 80 -evalue 1e-5 -outfmt 6"
    }

    withName: '.*:BLASTTOBED' {
        cpus       = 1
        memory     = 4.GB
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: "copy"
        ]
    }

    withName: '.*:BEDTOOLS_MASK_SATELLITES_HARD' {
        cpus     = 2
        memory   = 8.GB
        ext.args = ""
    }

    withName: '.*:BEDTOOLS_MASK_SATELLITES_SOFT' {
        cpus     = 2
        memory   = 8.GB
        ext.args = "-soft"
    }

    withName: '.*:SATELLITEPROFILER' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/repeats" },
            mode: "copy"
        ]
    }

    withName: '.*EARLGREY' {
        queue            = { task.exitStatus == 140 ? 'basement' : 'long' }
        cpus             = 8
        memory           = { (32.GB * (1.5 ** (task.attempt - 1))) }
        ext.args         = "-e yes"
        containerOptions = {
            workflow.containerEngine == 'singularity' ?
            "--env PERL5LIB=/usr/local/share/RepeatMasker --bind ${params.dfam_h5}:/usr/local/share/RepeatMasker/Libraries/Dfam.h5 --bind ${params.dfam_dir}:/usr/local/share/RepeatMasker/Libraries/famdb" : ''
        }
        publishDir = [
            path: { "${params.outdir}/repeats/earlgrey" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.endsWith('.softmasked.fasta') || filename.endsWith('.log')) return null
                return filename
            }
        ]
    }

    withName: '.*:BEDTOOLS_MASK_TE' {
        cpus     = 2
        memory   = 8.GB
        ext.args = "-soft"
    }

    // 2. RNA-seq Alignment
    withName: '.*:HISAT2_BUILD' {
        cpus   = 8
        memory = 32.GB
    }

    withName: '.*:SAMTOOLS_COLLATEFASTQ' {
        cpus   = 4
        memory = 16.GB
    }

    withName: '.*:HISAT2_ALIGN' {
        cpus   = 12
        memory = 32.GB
    }

    withName: '.*:SAMTOOLS_MERGE' {
        cpus   = 4
        memory = 16.GB
    }

    withName: '.*:BAM_TO_CRAM' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/rnaseq" },
            mode: "copy"
        ]
    }

    withName: '.*:INDEX_CRAM' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/rnaseq" },
            mode: "copy"
        ]
    }

    // 3. Spliced Leader (SLIDR)
    withName: '.*:SLIDR_EXTRACTTAILS' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/slidr/tails" },
            mode: "copy"
        ]
    }

    withName: '.*:SLIDR_CLUSTERTAILS' {
        cpus       = 4
        memory     = 16.GB
        publishDir = [
            path: { "${params.outdir}/slidr/clusters" },
            mode: "copy"
        ]
    }

    withName: '.*:SLIDR_SLRNASITES' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/slidr/sites" },
            mode: "copy"
        ]
    }

    withName: '.*:SLIDR_SLRNAFILTER' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/slidr/filtered" },
            mode: "copy"
        ]
    }

    // 4. Gene Prediction Multi-Candidate Tournament
    withName: '.*:BRAKER3' {
        cpus   = 16
        memory = 48.GB
        time   = '24.h'
    }

    withName: '.*:HELIXER' {
        cpus   = 8
        memory = 32.GB
        time   = '12.h'
    }

    withName: '.*:TSEBRA' {
        cpus   = 4
        memory = 16.GB
    }

    withName: '.*:SELECTBESTMODEL' {
        cpus       = 8
        memory     = 24.GB
        time       = '4.h'
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.endsWith('.tsv')) return "tournament_decision.tsv"
                return filename
            }
        ]
    }

    withName: '.*:GFFREAD_REPRESENTATIVE_FAA' {
        cpus       = 2
        memory     = 8.GB
        ext.prefix = { "${meta.id}.protein" }
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: "copy"
        ]
    }

    withName: '.*:GFFREAD_REPRESENTATIVE_FNA' {
        cpus       = 2
        memory     = 8.GB
        ext.prefix = { "${meta.id}.cds" }
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: "copy"
        ]
    }

    withName: '.*:ARCHIVE_SUBOPTIMAL_MODELS' {
        cpus       = 2
        memory     = 8.GB
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: "copy"
        ]
    }

    // 5. Functional Annotation (InterProScan)
    withName: '.*INTERPROSCAN.*' {
        cpus       = 16
        memory     = { (16.GB * (1.5 ** (task.attempt - 1))) }
        time       = '12.h'
        publishDir = [
            path: { "${params.outdir}/functional_annotation/interproscan" },
            mode: "copy"
        ]
    }

    // 6. RNA-seq Gene Abundance Quantification (featureCounts)
    withName: '.*:SUBREAD_FEATURECOUNTS' {
        cpus       = 2
        memory     = 8.GB
        ext.args   = "-p -t exon -g gene_id"
        publishDir = [
            path: { "${params.outdir}/expression" },
            mode: "copy"
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Test datasets
    assembly                   = "${projectDir}/assets/test_data/assembly.fasta"
    fai                        = "${projectDir}/assets/test_data/assembly.fasta.fai"
    rfam_cm                    = "${projectDir}/assets/test_data/test_rfam.cm"
    rnaseq_samplesheet         = "${projectDir}/assets/test_data/samplesheet.csv"
    proteins                   = "${projectDir}/assets/test_data/proteins.fasta"
    outdir                     = 'results'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test -stub

----------------------------------------------------------------------------------------
*/

executor {
    name = 'local'
}

process {
    executor       = 'local'
    resourceLimits = [
        cpus: 4,
        memory: '15.GB'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Test datasets
    assembly                   = "${projectDir}/assets/test_data/assembly.fasta"
    fai                        = "${projectDir}/assets/test_data/assembly.fasta.fai"
    rfam_cm                    = "${projectDir}/assets/test_data/test_rfam.cm"
    rnaseq_samplesheet         = "${projectDir}/assets/test_data/samplesheet.csv"
    proteins                   = "${projectDir}/assets/test_data/proteins.fasta"
    outdir                     = 'results'
}
